---
import Root from "../layouts/Root.astro";
import SocialLink from "../components/SocialLink.astro";
import Logo from "../../public/icon.svg";
import Github from "../../public/icons/github.svg";
import Twitter from "../../public/icons/twitter.svg";
import Instagram from "../../public/icons/instagram.svg";
import Linkedin from "../../public/icons/linkedin.svg";
import Steam from "../../public/icons/steam.svg";
import Email from "../../public/icons/mail.svg";
---

<style is:global>
  section {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 20px;
  }

  figure {
    max-width: 280px;

    figcaption {
      text-align: center;
      font-family: 400 var(--bs) / 1.3 var(--family-accent);
      text-transform: uppercase;
      background:
        linear-gradient(rgba(255, 255, 255, 0.75)),
        linear-gradient(#ffffff 0%, #d3b8d7 100%);
      background-blend-mode: soft-light, normal;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      mix-blend-mode: hard-light;
      filter: drop-shadow(0px 0px 1px rgba(40, 0, 0, 0.9))
        drop-shadow(0px 0px 7.06722px rgba(0, 0, 0, 0.75))
        drop-shadow(0px 0px 14.1344px rgba(0, 0, 0, 0.5));
    }
  }

  .links {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 24px;
    height: fit-content;
    padding: unset;
    list-style: none;
  }
</style>

<Root title="Home">
  <section>
    <figure>
      <Logo />
      <figcaption>
        <h1>Drake Costa</h1>
        <h2>Engineering • Design • Photography</h2>
      </figcaption>
    </figure>

    <ul class="links">
      <SocialLink id="github" url="//github.com/saeris">
        <Github />
        <span>Github</span>
      </SocialLink>
      <SocialLink id="twitter" url="//twitter.com/saeris">
        <Twitter />
        <span>Twitter</span>
      </SocialLink>
      <SocialLink id="instagram" url="//www.instagram.com/saeris.gg">
        <Instagram />
        <span>Instagram</span>
      </SocialLink>
      <SocialLink id="linkedin" url="//www.linkedin.com/in/saeris">
        <Linkedin />
        <span>Linkedin</span>
      </SocialLink>
      <SocialLink id="steam" url="//steamcommunity.com/id/ansrath">
        <Steam />
        <span>Steam</span>
      </SocialLink>
      <SocialLink id="email" url="mailto:yo@saer.is">
        <Email />
        <span>Email</span>
      </SocialLink>
    </ul>
  </section>
</Root>
